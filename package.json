{
  "name": "ai-storefront-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/api/index.ts",
    "deploy": "npm run build:production && wrangler pages deploy dist",
    "test:live": "node scripts/live-check.mjs",
    "test:pages": "node scripts/pages-check.mjs",
    "test:database": "node scripts/database-check.mjs",
    "check:deploy": "node scripts/check-deployment.mjs",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts vite.config.ts tsconfig.json package.json",
    "build:production": "npm run check:deploy && npm run build",
    "test:activation": "node scripts/activation-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test && npm run check:edge && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "^0.468.0",
    "posthog-js": "^1.280.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "deno": "^2.5.6",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.1.1",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
