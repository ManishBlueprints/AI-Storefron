# Server only. Copy to supabase/functions/.env; never commit that file.
# Supabase automatically supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.

# Exact frontend origin, without a trailing slash. Replace for deployment.
APP_ORIGIN=http://127.0.0.1:5173
# Required. Generate a fresh value with: openssl rand -hex 32
RATE_LIMIT_SALT=

# AI provider. An empty key uses anonymous Kilo access with shared limits.
AI_PROVIDER=kilo
KILO_API_KEY=
# Comma-separated free models. Confirm availability before deployment.
KILO_MODELS=nvidia/nemotron-3.5-super-vl:free
KILO_JSON_MODELS=nvidia/nemotron-3.5-super-vl:free
KILO_DISABLE_REASONING=true
KILO_MAX_TOKENS=3000

# Generation and regeneration quotas.
IP_GENERATIONS_PER_HOUR=10
GLOBAL_DAILY_GENERATION_CAP=100
