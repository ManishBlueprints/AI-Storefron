# Frontend only. Copy to .env.development.local for local development.
# Keep server credentials in supabase/functions/.env (see its example).

# Local Docker Supabase API.
VITE_API_URL=http://127.0.0.1:55321/functions/v1/api

# Production: remove the local VITE_API_URL above and set your hosted URL.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional analytics. Leave the key blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
