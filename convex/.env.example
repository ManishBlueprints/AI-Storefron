# Server configuration. Copy to .env.convex.local (ignored), then run:
# npx convex env set --from-file .env.convex.local
# Never place server credentials in VITE_ variables.
APP_ORIGIN=http://127.0.0.1:5173
# Required; generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
# Optional Kilo account key; blank uses shared anonymous access.
KILO_API_KEY=
KILO_MODELS=nvidia/nemotron-3.5-super-vl:free
KILO_JSON_MODELS=nvidia/nemotron-3.5-super-vl:free
KILO_DISABLE_REASONING=true
KILO_MAX_TOKENS=3000
IP_GENERATIONS_PER_HOUR=10
GLOBAL_DAILY_GENERATION_CAP=100
